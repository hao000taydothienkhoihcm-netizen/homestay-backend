// ═══════════════════════════════════════
// HOMESTAY MANAGER — PRISMA SCHEMA
// PostgreSQL backend
// ═══════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───── Host (mỗi host = 1 workspace, multi-tenant) ─────
// Bước 2: chỉ thêm bảng + cột hostId (nullable). Dữ liệu Sabi cũ backfill về host #1.
model Host {
  id        Int      @id @default(autoincrement())
  name      String // Tên hiển thị, VD "Haotran House"
  brand     String? // Thương hiệu, VD "Sabi Home"
  phone     String? // SĐT host (chỉ hiện cho sales SAU khi giữ chỗ + duyệt)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  homes           Home[]
  holidays        Holiday[]
  bookings        Booking[]
  chargeTemplates ChargeTemplate[]
  stockEntries    StockEntry[]
  expenses        Expense[]
  monthlyPrices   HomeMonthlyPrice[]
  datePrices      HomeDatePrice[]
  hoTroLogs       HoTroLog[]
  lichKhoa        LichKhoa[]

  // ───── GĐ3: gói & quyền lợi (chưa thu phí, chỉ để sẵn) ─────
  // plan: giai đoạn miễn phí tất cả để FREE. internalAppEnabled tách rời plan:
  // 10 host tiên phong ở FREE nhưng vẫn mở app nội bộ vĩnh viễn (ghi lý do ở internalAppNote,
  // VD "GIFT_FOUNDING" / "TRIAL:2026-12-31"). Admin khoá được bất cứ lúc nào nhưng KHÔNG khoá
  // nhóm tặng vĩnh viễn vì lý do thương mại (skill homestay-manager-full mục 2b).
  plan               HostPlan @default(FREE)
  internalAppEnabled Boolean  @default(true)
  internalAppNote    String?
}

enum HostPlan {
  FREE
  PER_BOOKING // 10.000đ / booking qua chợ
  FLAT // khoán 200.000đ / tháng
}

// ───── User & Auth ─────
model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String // bcrypt hash
  name     String
  email    String?
  role     Role    @default(STAFF)
  active   Boolean @default(true)

  // Trạng thái duyệt cho tài khoản tự đăng ký (Host/Sales). Mặc định ACTIVE
  // để mọi tài khoản CŨ không bị chặn. Đăng ký mới -> PENDING, admin duyệt -> ACTIVE.
  status UserStatus @default(ACTIVE)

  // Multi-tenant: user thuộc host nào. Null = tài khoản cấp nền tảng (ADMIN, SALES).
  hostId Int?
  host   Host? @relation(fields: [hostId], references: [id])

  hoTroLogs HoTroLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
}

// ───── Nhật ký admin vào hỗ trợ ─────
// Admin ngày thường KHÔNG thấy dữ liệu của host nào. Muốn xem/sửa hộ thì phải
// "vào hỗ trợ" một host cụ thể — mỗi lần vào ghi một dòng ở đây. Host xem được
// nhật ký này: đó là bằng chứng cho lời hứa "tôi không nhìn trừ khi bạn cần".
model HoTroLog {
  id      Int      @id @default(autoincrement())
  adminId Int
  admin   User     @relation(fields: [adminId], references: [id])
  hostId  Int
  host    Host     @relation(fields: [hostId], references: [id])
  lyDo    String?
  luc     DateTime @default(now())

  @@index([hostId, luc])
}

enum Role {
  ADMIN // Chủ nền tảng: quản lý host + tài khoản; KHÔNG thấy dữ liệu host trừ khi vào hỗ trợ
  MANAGER // Quản lý trong workspace của 1 host
  STAFF // Nhân viên trong workspace của 1 host
  HOST // Chủ nhà: sở hữu 1 workspace (multi-tenant)
  SALES // Cộng tác viên bán phòng ở marketplace
}

enum UserStatus {
  PENDING // Vừa đăng ký, chờ admin duyệt
  ACTIVE // Đã duyệt / tài khoản cũ
}

// ───── Homes ─────
model Home {
  id           Int     @id @default(autoincrement())
  name         String
  address      String
  price        Int // VND/đêm (giá ngày thường T2–T5)
  weekendPrice Int? // VND/đêm cuối tuần (T6, T7, CN). Null = dùng price
  holidayPrice Int? // VND/đêm ngày lễ (theo danh sách Holiday). Null = dùng giá cuối tuần
  maxGuests    Int     @default(8)
  emoji        String  @default("🏡")
  desc         String?
  active       Boolean @default(true)

  hostId Int?
  host   Host? @relation(fields: [hostId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings      Booking[]
  expenses      Expense[]
  stockEntries  StockEntry[]
  monthlyPrices HomeMonthlyPrice[]
  datePrices    HomeDatePrice[]
  lichKhoa      LichKhoa[]

  // ───── GĐ3: thông tin đăng chợ (theo mockup/marketplace-final.html, màn "addhome") ─────
  // Tất cả nullable — căn cũ không đụng. Giá host/đêm vẫn là price / weekendPrice / holidayPrice.
  choTrangThai   ChoTrangThai  @default(NHAP) // NHAP: chưa đăng · CHO_DUYET · DANG_BAN · AN
  salesTitle     String? // tiêu đề bán hàng, VD "Home mới xây chuẩn nghỉ dưỡng ngay trung tâm"
  street         String? // số nhà & tên đường (address = địa chỉ chính xác, chỉ sales thấy sau duyệt)
  ward           String? // phường/xã — lọc khu vực + chống trùng
  landmark       String? // điểm mốc gần
  bedrooms       Int? // số phòng ngủ
  bedroomsSingle Int? // phòng đơn
  bedroomsDouble Int? // phòng đôi
  minGuests      Int? // "6–8 khách" → minGuests 6, maxGuests 8
  roomNotes      String[]      @default([]) // mô tả từng phòng
  amenities      String[]      @default([]) // chip tiện ích (chuẩn + host tự thêm)
  parkingFree    String? // "1 xe (4–7 chỗ) trước nhà"
  parkingFee     String? // "200.000đ / xe / đêm"
  parkingNote    String?
  childUnder6    String? // MIEN_PHI | PHU_THU_NHE
  childFrom6     String? // NHU_NGUOI_LON | PHU_THU_50 | MIEN_PHI
  albumUrl       String? // link Drive bộ ảnh đầy đủ
  coverImages    String[]      @default([]) // tối đa 8 ảnh bìa (URL)
  salesInfo      String? // bài giới thiệu host tự điền — Sales bấm "Gửi khách" lấy nguyên khối này
  rules          String? // quy định của căn — chỉ đính vào phiếu khách lúc chốt
  caretakerPhone String? // hotline quản gia (chỉ sales thấy sau khi host duyệt giữ chỗ)
  // Hoa hồng sales — host chọn cho TỪNG CĂN (skill mục 4b). A = % giá bán, B = giá sàn + kê.
  coCheHoaHong   CoCheHoaHong?
  listPrice      Int? // A: giá bán niêm yết / đêm
  commissionPct  Int? // A: % hoa hồng
  floorPrice     Int? // B: giá sàn (host nhận) / đêm
  markupMin      Int? // B: cho kê từ
  markupMax      Int? // B: cho kê đến

  @@index([hostId])
  @@index([ward])
}

enum ChoTrangThai {
  NHAP // host chưa gửi lên chợ
  CHO_DUYET // đã gửi, chờ admin duyệt (kiểm trùng căn)
  DANG_BAN // đang hiện trên chợ
  AN // host/admin tạm ẩn
}

enum CoCheHoaHong {
  PHAN_TRAM // A · trả % theo giá bán, sales không được kê
  GIA_SAN // B · giá sàn + kê, sales kê tự do trong khoảng
}

// ───── GĐ3: LỊCH KHOÁ THEO NGÀY ─────
// Một dòng = một đêm bị khoá của một căn, ngoài booking nội bộ. Nguồn:
//   MANUAL = host bấm tay trên chợ (khách nhà, bảo trì, đã bán ngoài...)
//   SHEET  = đổ từ Google Sheet · ICAL = đổ từ link .ics
// QUY TẮC BẮT BUỘC (skill mục 5b): re-sync SHEET/ICAL chỉ được thêm/xoá dòng CÙNG nguồn,
// tuyệt đối không đụng dòng MANUAL. Ngày trống trên chợ = không booking AND không LichKhoa.
model LichKhoa {
  id          Int           @id @default(autoincrement())
  hostId      Int
  host        Host          @relation(fields: [hostId], references: [id])
  homeId      Int
  home        Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  ngay        DateTime      @db.Date
  nguon       NguonLichKhoa @default(MANUAL)
  ghiChu      String?
  createdById Int?
  createdAt   DateTime      @default(now())

  @@unique([homeId, ngay])
  @@index([hostId, ngay])
}

enum NguonLichKhoa {
  MANUAL
  SHEET
  ICAL
}

// ───── Bảng giá THEO THÁNG của từng căn ─────
// Giá nền đổi theo mùa (VD tháng thấp điểm 3,5tr; cao điểm 5tr). Mỗi năm nhập riêng.
// Ô nào để trống -> lùi về giá mặc định của căn (Home.price / weekendPrice / holidayPrice),
// nên căn nào chưa nhập bảng giá vẫn chạy y như trước.
model HomeMonthlyPrice {
  id           Int     @id @default(autoincrement())
  homeId       Int
  home         Home    @relation(fields: [homeId], references: [id], onDelete: Cascade)
  year         Int // VD 2026
  month        Int // 1–12
  price        Int? // giá ngày thường T2–T5
  weekendPrice Int? // giá T6, T7, CN
  holidayPrice Int? // giá ngày lễ (theo danh sách Holiday)
  note         String? // ghi chú tuỳ ý, VD "mùa thấp điểm"

  hostId Int?
  host   Host? @relation(fields: [hostId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([homeId, year, month])
  @@index([hostId])
  @@index([homeId, year])
}

// ───── Giá GHI ĐÈ cho MỘT đêm cụ thể ─────
// Ưu tiên cao nhất, thắng cả giá lễ. Dùng cho ngày lẻ / khuyến mãi / sự kiện.
model HomeDatePrice {
  id     Int      @id @default(autoincrement())
  homeId Int
  home   Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date // đêm bắt đầu từ ngày này
  price  Int
  note   String?

  hostId Int?
  host   Host? @relation(fields: [hostId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([homeId, date])
  @@index([hostId])
  @@index([date])
}

// ───── Ngày lễ (áp giá lễ cho mọi căn) ─────
model Holiday {
  id        Int      @id @default(autoincrement())
  name      String // VD: Tết Nguyên Đán, Lễ 30/4...
  startDate DateTime @db.Date
  endDate   DateTime @db.Date // = startDate nếu chỉ 1 ngày

  hostId Int?
  host   Host? @relation(fields: [hostId], references: [id])

  createdAt DateTime @default(now())

  @@index([startDate, endDate])
  @@index([hostId])
}

// ───── Bookings ─────
model Booking {
  id     Int    @id @default(autoincrement())
  guest  String
  phone  String
  homeId Int
  home   Home   @relation(fields: [homeId], references: [id])

  checkIn      DateTime @db.Date
  checkInTime  String   @default("14:00")
  checkOut     DateTime @db.Date
  checkOutTime String   @default("12:00")
  guests       Int      @default(2)

  // Dòng tiền
  totalAmount    Int // = price × nights
  discount       Int @default(0) // Giảm giá trên tổng đơn (VND)
  deposit        Int @default(0)
  paidAtCheckIn  Int @default(0)
  chargesTotal   Int @default(0) // Phụ thu TRẢ nhà (doanh thu khi CHECKEDOUT)
  checkinCharges Int @default(0) // Phụ thu NHẬN nhà (doanh thu ngay khi CHECKEDIN)

  status BookingStatus @default(CONFIRMED)
  notes  String?

  // GĐ3: booking từ đâu tới. INTERNAL = host/nhân viên nhập trong app nội bộ.
  // MARKETPLACE = sales chốt trên chợ rồi tự đẩy vào (GĐ4). Sau này tính phí
  // "10k/booking qua chợ" đếm theo cột này — để sẵn để khỏi sửa schema lần nữa.
  source BookingSource @default(INTERNAL)

  // Check-in/out thực tế
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  waterMeter     Float?
  inspectionNote String?

  charges Charge[]

  hostId Int?
  host   Host? @relation(fields: [hostId], references: [id])

  // Xoá mềm (thùng rác). Null = đang dùng. Có giá trị = đã xoá, còn khôi phục
  // được trong 30 ngày. Host xoá lộn thì tự cứu, không phải quay lại bản sao lưu
  // toàn hệ thống (làm mất luôn dữ liệu host khác nhập trong ngày).
  // MỌI truy vấn booking phải lọc deletedAt: null — xem bookingService.dangDung().
  deletedAt   DateTime?
  deletedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([homeId, checkIn, checkOut])
  @@index([status])
  @@index([hostId])
  @@index([deletedAt])
}

enum BookingStatus {
  CONFIRMED // Đã đặt
  CHECKEDIN // Đang ở
  CHECKOUT_TODAY // Trả hôm nay
  CHECKEDOUT // Đã trả
}

enum BookingSource {
  INTERNAL // nhập trong app nội bộ
  MARKETPLACE // chốt qua chợ (GĐ4)
}

// ───── Charges (phụ thu — nhận nhà hoặc trả nhà) ─────
model Charge {
  id        Int     @id @default(autoincrement())
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name   String
  unit   Int // Đơn giá
  qty    Int         @default(1)
  amount Int // = unit × qty
  phase  ChargePhase @default(CHECKOUT) // CHECKIN = thu lúc nhận nhà, CHECKOUT = thu lúc trả nhà

  // Liên kết cứng tới mặt hàng/mẫu phụ thu (để báo cáo kho khớp theo ID, không lệ thuộc tên).
  // Nullable + SetNull: xoá mẫu KHÔNG xoá lịch sử phụ thu; chỉ gỡ liên kết.
  templateId Int?
  template   ChargeTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([templateId])
}

enum ChargePhase {
  CHECKIN // Phụ thu khi nhận nhà (kê nệm...)
  CHECKOUT // Phụ thu khi trả nhà (dọn dẹp, nước uống...)
}

// ───── Charge Templates (RULES + QUICK) ─────
model ChargeTemplate {
  id     Int        @id @default(autoincrement())
  name   String
  amount Int
  type   ChargeType
  active Boolean    @default(true)

  // ── Quản lý kho (chỉ áp dụng cho QUICK — đồ tiêu thụ) ──
  trackStock Boolean @default(false) // Có theo dõi tồn kho không
  packSize   Int     @default(1) // Số đơn vị lẻ trong 1 thùng/lốc (VD 1 thùng = 24 chai)
  packLabel  String  @default("thùng") // Tên đơn vị nhập (thùng / lốc / kiện)
  unitLabel  String  @default("cái") // Tên đơn vị lẻ (chai / lon / gói)
  lowStock   Int     @default(0) // Ngưỡng cảnh báo tồn thấp (theo đơn vị lẻ)
  costPrice  Int     @default(0) // Giá vốn / giá nhập 1 đơn vị lẻ (để tính lợi nhuận)

  stockEntries StockEntry[]
  charges      Charge[]

  hostId Int?
  host   Host? @relation(fields: [hostId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
}

enum ChargeType {
  RULE // Nội quy phạt — không có số lượng
  QUICK // Tiêu thụ — có số lượng
}

// ───── Nhập kho / điều chỉnh tồn (theo từng căn) ─────
model StockEntry {
  id         Int            @id @default(autoincrement())
  templateId Int
  template   ChargeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  homeId     Int
  home       Home           @relation(fields: [homeId], references: [id])

  qty  Int // Số đơn vị lẻ (đã quy đổi từ thùng). ADJUST có thể âm.
  type StockType @default(IMPORT)
  note String?
  date DateTime  @db.Date

  hostId Int?
  host   Host? @relation(fields: [hostId], references: [id])

  createdAt DateTime @default(now())

  @@index([templateId, homeId])
  @@index([date])
  @@index([hostId])
}

enum StockType {
  IMPORT // Nhập hàng
  ADJUST // Kiểm kê / điều chỉnh tồn
}

// ───── Expenses (chi phí vận hành) ─────
model Expense {
  id       Int      @id @default(autoincrement())
  date     DateTime @db.Date
  category String
  desc     String
  amount   Int
  homeId   Int?
  home     Home?    @relation(fields: [homeId], references: [id])

  hostId Int?
  host   Host? @relation(fields: [hostId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([hostId])
}
